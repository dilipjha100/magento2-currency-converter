        <referenceContainer name="content">
            <block class="Magento\Framework\View\Element\Template"
                   name="dilip.currency.converter"
                   template="Dilip_CurrencyConverter::converter.phtml">
                <arguments>
                    <argument name="view_model" xsi:type="object">Dilip\CurrencyConverter\ViewModel\Converter</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
